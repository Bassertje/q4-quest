# Copy this file to .env (git-ignored) for local development against a real
# Home Assistant instance. Never commit the filled-in version.
HA_URL=http://your-home-assistant:8123
HA_TOKEN=your-long-lived-access-token

# Optional: path to a JSON file with the same keys as the add-on options.
# OPTIONS_PATH=./options.local.json

# Optional: where the database is stored (default ./data/q4quest.db outside the add-on).
# DB_PATH=./data/q4quest.db
