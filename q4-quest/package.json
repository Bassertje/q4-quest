{
  "name": "q4-quest",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "mock": "MOCK=1 node --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:server": "MOCK=1 node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.19.0",
    "svelte": "^5.57.3",
    "typescript": "^5.9.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
